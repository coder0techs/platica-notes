{
  "manifest_version": 3,
  "name": "Plática Notes",
  "version": "0.1.0",
  "description": "Saves Google Meet transcripts and chat locally.",
  "permissions": ["storage", "downloads"],
  "host_permissions": ["https://meet.google.com/*"],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["meet-rtc-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content-meet.js"]
    }
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Plática Notes" }
}
