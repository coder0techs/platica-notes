  "license": "ISC",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/chrome": "^0.1.43",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
