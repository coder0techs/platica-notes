{
  "name": "platica-notes",
  "version": "1.16.1",
  "description": "Chrome extension that saves Google Meet transcripts and chat locally.",
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "build": "node build.mjs",
    "site": "node scripts/site.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "check": "node scripts/check-invariants.mjs",
    "release": "node scripts/release.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "promo-tiles": "node scripts/promo-tiles.mjs",
    "manual": "node scripts/manual.mjs",
    "package": "npm run check && npm run typecheck && npm test && npm run build && node scripts/package.mjs"
  },
  "keywords": [],
  "author": "coder0techs",
  "license": "ISC",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/chrome": "^0.1.43",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.28.0",
    "marked": "^18.0.5",
    "playwright": "^1.62.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
