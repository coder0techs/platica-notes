{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    // The release helpers under scripts/ are plain .mjs so node can run them
    // directly; allowJs lets the tests import them with real types.
    "allowJs": true
  },
  "include": ["src", "tests", "scripts"]
}
